# Copy to backend/.env for local API development. Never commit real values.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=replace-me
SUPABASE_SERVICE_ROLE_KEY=replace-me
SUPABASE_JWT_SECRET=replace-me-with-a-long-random-secret
ATTENDANCE_CORS_ORIGINS=http://localhost:4173,http://localhost:3001
ATTENDANCE_STORAGE_BUCKET=attendance-submissions
ATTENDANCE_IMAGE_RETENTION_DAYS=30
ATTENDANCE_MAX_CAPTURE_BYTES=10485760
ATTENDANCE_PERSON_MODEL=yolo11n.pt
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ATTENDANCE_BIOMETRIC_ENCRYPTION_KEY=replace-me
ATTENDANCE_FACE_MODEL=Facenet512
ATTENDANCE_FACE_SIMILARITY_THRESHOLD=0.78
