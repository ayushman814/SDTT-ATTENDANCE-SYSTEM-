# Panorama attendance API — environment variables. Copy to .env (never commit it).

# REQUIRED in production: a long random string used to sign JWTs.
PANORAMA_JWT_SECRET=change-me-to-a-long-random-string

# Database: SQLite by default; use Postgres in production, e.g.
# PANORAMA_DATABASE_URL=postgresql+psycopg2://user:pass@host:5432/attendance
PANORAMA_DATABASE_URL=sqlite:///./panorama.db

# Token lifetime (seconds)
PANORAMA_JWT_TTL_SECONDS=28800

# Model + upload storage
PANORAMA_MODELS_DIR=./models
PANORAMA_UPLOAD_DIR=./uploads

# CORS origins allowed to call the API (comma-separated)
PANORAMA_CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# Path to the thresholds config file
PANORAMA_CONFIG=./panorama.config.yaml
