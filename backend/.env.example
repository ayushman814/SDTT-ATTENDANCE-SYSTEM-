# ─────────────────────────────────────────────────────────────
#  Classroom Attendance – Backend Environment Variables
#  Copy this file to .env and fill in your values.
#  NEVER commit the real .env file to version control.
# ─────────────────────────────────────────────────────────────

# ── Supabase ─────────────────────────────────────────────────
# Find these in: Supabase Dashboard → Project Settings → API

# Your project URL (e.g. https://xyzxyzxyz.supabase.co)
SUPABASE_URL=https://your-project-id.supabase.co

# "anon" public key (safe for client SDKs)
SUPABASE_ANON_KEY=your-anon-key-here

# "service_role" secret key (NEVER expose this to clients – backend only)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# JWT secret for verifying Supabase-issued tokens
# Find in: Supabase Dashboard → Project Settings → API → JWT Secret
SUPABASE_JWT_SECRET=your-jwt-secret-here

# ── Application ───────────────────────────────────────────────
ATTENDANCE_ENV=development

# Token / WebSocket settings
ATTENDANCE_TOKEN_TTL_SECONDS=28800
ATTENDANCE_WS_TICKET_TTL_SECONDS=60
ATTENDANCE_MAX_CAPTURE_BYTES=10485760
ATTENDANCE_STORAGE_BUCKET=attendance-submissions
ATTENDANCE_IMAGE_RETENTION_DAYS=30
ATTENDANCE_MIN_VISIBLE_PEOPLE=2

# Pretrained Ultralytics YOLO model. The first inference downloads this model
# to the local cache unless ATTENDANCE_PERSON_MODEL points to a local weights file.
ATTENDANCE_PERSON_MODEL=yolo11n.pt
ATTENDANCE_MIN_IMAGE_WIDTH=1000
ATTENDANCE_MIN_IMAGE_HEIGHT=500
ATTENDANCE_MIN_IMAGE_ASPECT_RATIO=1.7
ATTENDANCE_MIN_BLUR_VARIANCE=18
ATTENDANCE_MIN_BRIGHTNESS=35
ATTENDANCE_MAX_BRIGHTNESS=235
ATTENDANCE_PERSON_MIN_CONFIDENCE=0.35

# Allowed CORS origins (comma-separated)
ATTENDANCE_CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8081

# ── Biometrics & Security ─────────────────────────────────────
# Fernet AES-128 key (Generate via: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
ATTENDANCE_BIOMETRIC_ENCRYPTION_KEY=

# ── Continuous Sweep Verification Thresholds ──────────────────
MIN_FRAMES=12
MIN_DURATION_SECONDS=4.0
MAX_DURATION_SECONDS=15.0
MIN_HEADING_SPAN_DEGREES=150.0
MAX_HEADING_GAP_DEGREES=25.0
MIN_LAPLACIAN_VAR=100.0
MIN_LUMINANCE=40.0
MAX_LUMINANCE=220.0
SELF_SIMILARITY_PASS=0.72
SELF_SIMILARITY_FLAG=0.50
MIN_NEIGHBOURS=1
MIN_LECTURER_IPD_PX=30.0
SESSION_GRACE_PERIOD_SECONDS=5.0
FILMSTRIP_RETENTION_DAYS=7

